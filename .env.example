# Variables necesarias para la conexión con Supabase (solo en el servidor).
# En Vercel: Project Settings -> Environment Variables.
# Copia este archivo como .env para desarrollo local.

SUPABASE_URL=https://tu-proyecto.supabase.co

# Usa una de las dos claves públicas (la anon key o la publishable key).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcional: solo si necesitas saltarte RLS desde el servidor.
# No la expongas nunca en el cliente.
# SUPABASE_SERVICE_ROLE_KEY=
